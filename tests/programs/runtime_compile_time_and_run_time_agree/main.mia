
from io import print, println
from memory import alloc, realloc, free, copy

collatz :: (start: u64) -> u64 {
	let n = start;
	let steps: u64 = 0;
	while n != 1 {
		if n % 2 == 0 {
			n /= 2;
		}
		else {
			n = 3 * n + 1;
		}
		steps += 1;
	}
	return steps;
}

mix :: (seed: u32) -> u32 {
	let h = seed;
	for i in 0..8 {
		[wrap] h = h * 2654435761 + (u32)i;
		h ^= h >> 13;
	}
	return h;
}

shapes :: () -> f32 {
	let total: f32 = 0;
	for i in 1..=10 {
		total += 1.0f32 / (f32)i;
	}
	return total;
}

C1 :: collatz(27);
C2 :: mix(42);
C3 :: shapes();

pub main :: () {
	println("{}", C1 == collatz(27));
	println("{}", C2 == mix(42));
	println("{}", C3 == shapes());
}
