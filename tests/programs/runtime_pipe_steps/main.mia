
# every kind of pipe step: plain, defaulted, generic, local and plugin functions,
# function values, a call result in parentheses; values of every kind.
import io
import memory
import option

Point :: {
	let x: int;
	let y: int;
}

double :: (x: int) -> int then return x * 2;
add :: (x: int, y: int = 100) -> int then return x + y;
same<T> :: (x: T) -> T then return x;
pair<A, B> :: (a: A, b: B) -> uint then return sizeof(A) + sizeof(B);
norm :: (p: Point) -> int then return p.x * p.x + p.y * p.y;

shift :: (p: &Point, by: int) {
	p.x += by;
	p.y += by;
}

length :: (s: []int) -> uint then return lenof(s);
scale :: (x: f64, by: f64) -> f64 then return x * by;
narrow :: (x: u8) -> u8 then return x;
make :: () -> (int) -> int then return double;

TWELVE :: 6 ~ double;
SQUARES :: squares();

squares :: () -> [4]int {
	let t: [4]int = {};
	for i in 0..4 then t[i] = i ~ double;
	return t;
}

pub main :: () {
	io.println("1 {}", 3 ~ double);                          # plain
	io.println("2 {}", 3 ~ add);                             # default argument
	io.println("3 {}", 3 ~ add(4));                          # extra argument
	io.println("4 {}", 3 ~ same);                            # generic, inferred
	io.println("5 {}", 3 ~ same<int>);                       # generic, explicit
	io.println("6 {}", 1 ~ pair(2.5));                       # two type parameters
	io.println("7 {}", (Point){ x: 3, y: 4, } ~ norm);       # typed literal
	let f = double;
	io.println("8 {}", 5 ~ f);                               # function value
	io.println("9 {}", 5 ~ (make()));                       # call result as step
	local :: (x: int) -> int then return x - 1;
	io.println("10 {}", 5 ~ local);                          # local function
	io.println("11 {}", 2.0 ~ scale(1.5));                   # float literal
	io.println("12 {}", 255 ~ narrow);                       # literal fits u8
	let numbers: [3]int = { 1, 2, 3, };
	io.println("13 {}", numbers[..] ~ length);               # slice
	io.println("14 {}", { 1, 2, 3, 4 } ~ length);            # hidden array for a slice
	io.println("15 {} {}", TWELVE, SQUARES);                  # compile time
	let p: Point = { x: 1, y: 1, };
	&p ~ shift(2);                                           # variable, &
	io.println("17 {}", p);
	let heap = 4 ~ memory.alloc<int>;                        # plugin, explicit generic
	io.println("18 {}", lenof(heap));
	_ = heap ~ memory.free;
	"19 {}" ~ io.println(42);                                # variadic plugin
	io.println("20 {}", 7 ~ option.some ~ option.unwrap);  # temporaries into &
	let total = 0;
	for i in 0..(3 ~ double) then total += i;              # range end
	io.println("21 {}", total);
	let n = 0;
	while (n ~ double) < 10 then n += 1;
	io.println("22 {}", n);
	io.println("23 {}", add(1 ~ double, 2 ~ double));      # pipes in arguments
	io.println("24 {}", 1 + 2 * 3 ~ double);                # binds loosest
}
