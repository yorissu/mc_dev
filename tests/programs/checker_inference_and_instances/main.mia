
Pair<A, B> :: {
	let first: A;
	let second: B;
}

pair<A, B> :: (a: A, b: B) -> Pair<A, B> {
	return { first: a, second: b, };
}

add<T> :: (a: T, b: T) -> T {
	return a + b;
}

f :: () -> int {
	let p = pair(1, 2.5);
	_ = add<f32>(1, 2);
	_ = add(1.5, 2.5);
	return add(p.first, 3);
}

pub main :: () {}
