
from io import print, println
from memory import alloc, realloc, free, copy

Point :: {
	let x: int;
	let y: int;
}

swap<T> :: (a: &T, b: &T) {
	let t = a;
	a = b;
	b = t;
}

grow :: (p: &Point) {
	p.x += 1;
	p.y *= 10;
}

total :: (p: &Point) -> int {
	return p.x + p.y;
}

bump :: (value: &int) {
	value += 1;
}

pub main :: () {
	let a = 1;
	let b = 2;
	swap(&a, &b);
	println("{}", a * 10 + b);
	let p: Point = { x: 1, y: 2, };
	grow(&p);
	println("{}", p);
	swap(&p.x, &p.y);
	println("{}", total(&p));
	println("{}", total(&{ x: 5, y: 6, }));
	let items: [3]int = {};
	bump(&items[2]);
	let s = items[..];
	bump(&s[0]);
	println("{}", items);
}
