
# the program the crafted .miab files of this test are made from (see fixtures.py).

from io import println

S :: {
	let a: int;
	let b: [2]u8;
	let c: int;
}

make :: () -> S {
	return { a: 1, b: { 2, 3, }, c: 4, };
}

C :: make();

take :: (s: S, n: int) -> int then return s.a + n;

pub main :: () {
	let s = C;
	println("{} {}", s, take(s, 2));
}
