
# the program the crafted .miab files of this test are made from (see fixtures.py).
from io import println

S :: {
	let a: int;
	let b: [2]u8;
	let c: int;
}

C :: (S){ a: 1, b: { 2u8, 3u8 }, c: 4 };
T :: "text"c;

take :: (s: S, n: int) -> int {
	return s.a + n;
}

pub main :: () {
	let s = C;
	let t = T[1..3];
	println("{} {} {}", s, take(s, 2), t);
}
