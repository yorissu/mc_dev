
from io import print, println
from memory import alloc, realloc, free, copy

pub main :: () {
	println("[{}] [{:05}] [{:+}] [{:#x}] [{:#X}]", -42, -42, 7, 255, -255);
	println("[{:#010b}] [{:o}] [{:*<6}] [{:^7}] [{:>3}]", 5, 8, 1, 123, 12345);
	println("[{}] [{}] [{:.3f}] [{:08.2f}] [{:e}]", 0.1, 1.0, 3.14159, -1.5, 1234.5);
	println("[{:.1E}] [{:.3g}] [{:+.1f}] [{:<6}]", 0.00012, 1234.5, 2.0, 0.5);
	println("[{:4}] [{:>4}] [{:-^5}] [{:1}]", "té", "té", "té", "té");
	println("[{:>6}] [{:<5}] [{:^9}]", true, false, (u8)7);
}
