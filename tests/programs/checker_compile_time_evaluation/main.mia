
fib :: (n: int) -> int {
	if n < 2 {
		return n;
	}
	return fib(n - 1) + fib(n - 2);
}

sum_down :: (n: int) -> int {
	let total = 0;
	for i in n..=0 {
		total += i;
	}
	return total;
}

FIB :: fib(15);
DOWN :: sum_down(4);
SIZE :: 4 * 4;
TABLE :: ([SIZE]u8){};
HALF :: (f32)SIZE / 2;

pub main :: () {}
