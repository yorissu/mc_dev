NEGATED :: -MINIMUM;
DOUBLE :: BIG * 2;
SHIFTED :: 1 << 127;
HIGH :: 1 << 126;
TOO_BIG :: 340282366920938463463374607431768211456;
TOO_BIG_HEX :: 0x1_0000_0000_0000_0000_0000_0000_0000_0000;
