
# single-statement bodies: `then` after the condition of if, while and for;
# `else` takes its statement right away.

from io import println

sign :: (x: int) -> int {
	if x < 0 then return -1;
	else if x == 0 then return 0;
	else return 1;
}

pub main :: () {
	println("{} {} {}", sign(-5), sign(0), sign(7));
	let total = 0;
	for i in 1..=4 then total += i;
	while total < 100 then total *= 2;
	println("{}", total);
}
