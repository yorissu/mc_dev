
# a function's body can be `then` and one statement; an `else` belongs to
# the nearest `if` without one.

from io import println

square :: (x: int) -> int then return x * x;

pick :: (x: int) -> int {
	if x > 0 then
		if x > 10 then return 2;
		else return 1;
	return 0;
}

pub main :: () then println("{} {} {} {}", square(7), pick(20), pick(5), pick(-1));
