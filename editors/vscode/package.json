
{
	"name": "mia-language",
	"displayName": "mia",
	"description": "Syntax highlighting for mia source files.",
	"version": "0.1.0",
	"publisher": "mia",
	"license": "UNLICENSED",
	"engines": {
		"vscode": "^1.60.0"
	},
	"categories": [
		"Programming Languages"
	],
	"contributes": {
		"languages": [
			{
				"id": "mia",
				"aliases": [
					"mia"
				],
				"extensions": [
					".mia"
				],
				"configuration": "./language-configuration.json"
			}
		],
		"grammars": [
			{
				"language": "mia",
				"scopeName": "source.mia",
				"path": "./syntaxes/mia.tmLanguage.json"
			}
		]
	}
}
