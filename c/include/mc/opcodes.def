
/// the instructions of the virtual machine: name, how many type codes it
/// carries in its name (0, 1 or 2) and how many integer operands it takes
/// (0 to 3). typed instructions show their codes in their name: 'ADD_S32',
/// 'LOAD_U8', 'CAST_INT_F32', 'INDEX_SLICE_F32_UINT'. see bytecode.h for what
/// each one does.

// constants and the operand stack
mc_opcode(CONST, 0, 1)
mc_opcode(ZERO, 0, 1)
mc_opcode(POP, 0, 1)
mc_opcode(DUP, 0, 1)
// locals of the frame
mc_opcode(LOAD, 1, 1)
mc_opcode(LOAD_BYTES, 0, 2)
mc_opcode(STORE, 1, 1)
mc_opcode(STORE_BYTES, 0, 2)
// locations: a block and a byte offset in it
mc_opcode(LOC_LOCAL, 0, 1)
mc_opcode(LOC_CONST, 0, 1)
mc_opcode(LOC_FIELD, 0, 1)
mc_opcode(LOC_INDEX, 1, 2)
mc_opcode(LOC_INDEX_SLICE, 1, 1)
mc_opcode(TEMP_LOC, 1, 1)
mc_opcode(TEMP_LOC_BYTES, 0, 2)
mc_opcode(LOAD_LOC, 1, 0)
mc_opcode(LOAD_LOC_BYTES, 0, 1)
mc_opcode(STORE_LOC, 1, 0)
mc_opcode(STORE_LOC_BYTES, 0, 1)
// structs and arrays on the operand stack
mc_opcode(FIELD, 1, 2)
mc_opcode(FIELD_BYTES, 0, 3)
mc_opcode(SET_FIELD, 1, 2)
mc_opcode(SET_FIELD_BYTES, 0, 3)
mc_opcode(MAKE_ARRAY, 1, 1)
mc_opcode(MAKE_ARRAY_BYTES, 0, 2)
mc_opcode(INDEX, 2, 2)
mc_opcode(INDEX_BYTES, 1, 3)
// slices
mc_opcode(INDEX_SLICE, 2, 0)
mc_opcode(INDEX_SLICE_BYTES, 1, 1)
mc_opcode(LEN_SLICE, 0, 0)
mc_opcode(SLICE_IS_NULL, 0, 0)
mc_opcode(SLICE_LOC, 2, 3)
mc_opcode(SLICE_SLICE, 2, 2)
// control
mc_opcode(JUMP, 0, 1)
mc_opcode(JUMP_IF_FALSE, 0, 1)
mc_opcode(JUMP_IF_TRUE, 0, 1)
mc_opcode(NOT, 0, 0)
mc_opcode(RANGE_INIT, 1, 2)
mc_opcode(RANGE_TEST, 0, 2)
mc_opcode(RANGE_STEP, 0, 1)
mc_opcode(CALL, 0, 1)
mc_opcode(CALL_VALUE, 0, 2)
mc_opcode(CALL_INTRINSIC, 0, 2)
mc_opcode(FUNCTION, 0, 1)
mc_opcode(INTRINSIC, 0, 1)
mc_opcode(RETURN, 0, 1)
mc_opcode(ASSERT_FAIL, 0, 1)
// arithmetic and comparisons
mc_opcode(ADD, 1, 0)
mc_opcode(SUB, 1, 0)
mc_opcode(MUL, 1, 0)
mc_opcode(DIV, 1, 0)
mc_opcode(MOD, 1, 0)
mc_opcode(AND, 1, 0)
mc_opcode(OR, 1, 0)
mc_opcode(XOR, 1, 0)
mc_opcode(SHL, 2, 0)
mc_opcode(SHR, 2, 0)
mc_opcode(EQ, 1, 0)
mc_opcode(NE, 1, 0)
mc_opcode(LT, 1, 0)
mc_opcode(GT, 1, 0)
mc_opcode(LE, 1, 0)
mc_opcode(GE, 1, 0)
mc_opcode(NEG, 1, 0)
mc_opcode(BITNOT, 1, 0)
mc_opcode(CAST, 2, 0)
