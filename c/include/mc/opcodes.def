
/// the instructions of the virtual machine: name and operand shape
/// ('-' none, 'i' an integer, 'p' a pair). typed instructions (marked 't')
/// carry a type code in their name: 'ADD_S32', 'LT_F64', 'EQ_FN';
/// CAST carries two: 'CAST_INT_F32'. see bytecode.h for what each one does.

mc_opcode(CONST, 'i')
mc_opcode(NONE, '-')
mc_opcode(POP, '-')
mc_opcode(DUP, '-')
mc_opcode(LOAD, 'i')
mc_opcode(LOAD_DEREF, 'i')
mc_opcode(STORE, 'i')
mc_opcode(STORE_NEW, 'i')
mc_opcode(LOC_LOCAL, 'i')
mc_opcode(LOC_FIELD, 'i')
mc_opcode(LOC_INDEX_ARRAY, '-')
mc_opcode(LOC_INDEX_SLICE, '-')
mc_opcode(TEMP_LOC, '-')
mc_opcode(LOAD_LOC, '-')
mc_opcode(STORE_LOC, '-')
mc_opcode(FIELD, 'i')
mc_opcode(SET_FIELD, 'i')
mc_opcode(MAKE_ARRAY, 'i')
mc_opcode(INDEX_ARRAY, '-')
mc_opcode(INDEX_SLICE, '-')
mc_opcode(LEN_SLICE, '-')
mc_opcode(SLICE_LOC, 'i')
mc_opcode(SLICE_SLICE, 'i')
mc_opcode(SLICE_IS_NULL, '-')
mc_opcode(JUMP, 'i')
mc_opcode(JUMP_IF_FALSE, 'i')
mc_opcode(JUMP_IF_TRUE, 'i')
mc_opcode(NOT, '-')
mc_opcode(RANGE_INIT, 'p')
mc_opcode(RANGE_TEST, 'p')
mc_opcode(RANGE_STEP, 'i')
mc_opcode(CALL, 'p')
mc_opcode(CALL_VALUE, 'i')
mc_opcode(CALL_BUILTIN, 'p')
mc_opcode(CALL_NATIVE, 'p')
mc_opcode(FUNCTION, 'i')
mc_opcode(FUNCTION_BUILTIN, 'i')
mc_opcode(RETURN, '-')
mc_opcode(ASSERT_FAIL, 'i')
mc_opcode(ADD, 't')
mc_opcode(SUB, 't')
mc_opcode(MUL, 't')
mc_opcode(DIV, 't')
mc_opcode(MOD, 't')
mc_opcode(AND, 't')
mc_opcode(OR, 't')
mc_opcode(XOR, 't')
mc_opcode(SHL, 't')
mc_opcode(SHR, 't')
mc_opcode(EQ, 't')
mc_opcode(NE, 't')
mc_opcode(LT, 't')
mc_opcode(GT, 't')
mc_opcode(LE, 't')
mc_opcode(GE, 't')
mc_opcode(NEG, 't')
mc_opcode(BITNOT, 't')
mc_opcode(CAST, 'c')
