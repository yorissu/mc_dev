
/// every diagnostic: its code, a short name and an explanation (shown by
/// 'mc explain <code>'). 'E' codes are errors, 'W' warnings. the two digits
/// after the letter are the area: 01 lexing, 02 syntax, 03 modules,
/// 04 declarations and attributes, 05 types, 06 command line,
/// 07 compile-time evaluation.
///
/// to add a diagnostic, add a line here and report it with mc_error/mc_warning.

// lexing
mc_diagnostic(E0101, unknown_character, "a character that is not part of the language (outside strings and comments).")
mc_diagnostic(E0102, unterminated_string, "a string literal is not closed before the end of its line.")
mc_diagnostic(E0103, unterminated_comment, "a block comment is not closed; block comments nest, so every `/*` needs its own `*/`.")
mc_diagnostic(E0104, invalid_escape, "an unknown escape in a string or character literal. valid: \\n \\t \\r \\0 \\\\ \\\" \\' \\xHH.")
mc_diagnostic(E0105, invalid_number, "a malformed number: misplaced `_`, an unknown suffix, or a float suffix on a hexadecimal number.")
mc_diagnostic(E0106, invalid_character_literal, "a character literal must hold exactly one byte, like 'a' or '\\n'.")
mc_diagnostic(E0107, invalid_string_suffix, "the only string suffix is `c`, which adds a terminating NUL: \"text\"c.")
mc_diagnostic(E0108, nul_in_c_string, "a C string (\"...\"c) contains a NUL byte; C would stop reading there.")
// syntax
mc_diagnostic(E0201, unexpected_token, "the parser expected something else here.")
mc_diagnostic(E0202, ambiguous_precedence, "operators are strict: bit operators, shifts, mixing `&&` with `||`, and chained comparisons need parentheses.")
mc_diagnostic(E0203, empty_struct, "a struct needs at least one `let` field.")
mc_diagnostic(E0204, invalid_attribute, "a malformed attribute list `[name, name = value, op._+_]`, or attributes where none are allowed.")
mc_diagnostic(E0205, misplaced_declaration, "structs and generic declarations are only allowed at module level; local declarations cannot be `pub`.")
mc_diagnostic(E0206, invalid_braceless_body, "a body without braces cannot be a declaration; wrap it in `{ }`.")
// modules
mc_diagnostic(E0301, module_not_found, "an imported module was not found in any search directory.")
mc_diagnostic(E0302, import_cycle, "modules import each other in a cycle; move shared declarations into their own module.")
mc_diagnostic(E0303, not_public, "a declaration of another module is used, but it is not `pub`.")
mc_diagnostic(E0304, ambiguous_import, "a name is provided by several `*` imports; import it explicitly or declare it.")
mc_diagnostic(E0305, unknown_module_member, "a module does not declare the requested name.")
mc_diagnostic(E0306, duplicate_import, "the same name is imported twice.")
// declarations and attributes
mc_diagnostic(E0401, duplicate_declaration, "a name is declared twice in the same scope.")
mc_diagnostic(E0402, unknown_attribute, "an attribute that does not exist.")
mc_diagnostic(E0403, attribute_not_applicable, "an attribute that does not apply here, is repeated, or has a wrong value.")
mc_diagnostic(E0404, missing_body, "a function has no body; only `[builtin]` and `[extern]` functions are declared without one.")
mc_diagnostic(E0405, unexpected_body, "`[builtin]` and `[extern]` functions are implemented elsewhere and cannot have a body.")
mc_diagnostic(E0406, invalid_operator_pattern, "an `[op...]` pattern that is not an operator, like `_+_`, `-_` or `_[_]`.")
mc_diagnostic(E0407, operator_arity, "an operator function needs one parameter per `_` of its pattern.")
mc_diagnostic(E0408, derived_operator, "`!=`, `>`, `<=`, `>=` and `a op= b` are derived from `==`, `<` and `op`; they cannot be declared.")
mc_diagnostic(E0409, operator_signature, "operator functions take values, return a value (`bool` for `==` and `<`), and are not generic or variadic.")
mc_diagnostic(E0410, duplicate_operator, "two operator functions for the same pattern and operand types.")
mc_diagnostic(E0411, invalid_main, "the entry module needs `pub main :: ()` or `pub main :: () -> int`.")
mc_diagnostic(E0412, default_parameter_order, "parameters with defaults must come last; lambdas cannot have defaults.")
mc_diagnostic(E0413, reference_not_allowed, "references (`&T`) exist only as parameter types; use a slice to keep a view of an array.")
mc_diagnostic(E0414, recursive_struct, "a struct contains itself by value; store it through a slice instead.")
mc_diagnostic(E0415, variadic_parameter, "only `[builtin]` and `[extern]` functions take `...`, and only as their last parameter.")
// types
mc_diagnostic(E0501, undefined_name, "a name that is not declared (or not imported).")
mc_diagnostic(E0502, type_mismatch, "a value of one type is used where another type is expected; mc never converts implicitly.")
mc_diagnostic(E0503, not_a_type, "a name used as a type does not name a type.")
mc_diagnostic(E0504, not_callable, "a call of something that is not a function.")
mc_diagnostic(E0505, argument_count, "a call with the wrong number of arguments.")
mc_diagnostic(E0506, cannot_infer, "the compiler cannot work out a type; write it explicitly.")
mc_diagnostic(E0507, invalid_operands, "an operator does not apply to these operand types; mixed number types need a cast.")
mc_diagnostic(E0508, not_assignable, "an assignment to something that cannot change: not `mut`, a read-only reference, a loop variable or a temporary.")
mc_diagnostic(E0509, discarded_result, "the result of an expression is not used; write `_ = expression;` to discard it on purpose.")
mc_diagnostic(E0510, invalid_cast, "casts convert between number types only.")
mc_diagnostic(E0511, literal_out_of_range, "a literal does not fit in its type.")
mc_diagnostic(E0512, no_such_field, "a struct has no field of this name.")
mc_diagnostic(E0513, not_indexable, "only arrays, slices and types with an `[op._[_]]` function can be indexed.")
mc_diagnostic(E0514, missing_return, "a function with a result can reach its end without returning.")
mc_diagnostic(E0515, outside_loop, "`break` or `continue` outside of a loop.")
mc_diagnostic(E0516, capture, "lambdas and local functions cannot use variables of the enclosing function; pass them as arguments.")
mc_diagnostic(E0517, reference_argument, "a reference parameter needs `&value` (or `mut &value`) at the call.")
mc_diagnostic(E0518, reference_mutability, "`&` and `mut &` at the call must match the parameter (`p: &T` or `mut p: &T`).")
mc_diagnostic(E0519, misplaced_reference, "`&` is only allowed on arguments of reference parameters.")
mc_diagnostic(E0520, generic_argument_count, "a generic needs exactly as many type arguments as it has type parameters.")
mc_diagnostic(E0521, not_generic, "type arguments given to something that is not generic.")
mc_diagnostic(E0522, private_field, "the fields of a struct that is not `pub` are private to its module.")
mc_diagnostic(E0523, no_value, "a function without a result is used as a value.")
mc_diagnostic(E0524, invalid_return, "`return` with a value in a function without a result, or without one in a function with a result.")
mc_diagnostic(E0525, invalid_literal, "a `{ ... }` literal does not fit its type: names for structs, the right number of elements for arrays.")
mc_diagnostic(E0526, no_zero_value, "function types have no zero value, so `{}` and omitted fields of that type are not allowed.")
mc_diagnostic(E0527, instantiation_depth, "a generic function instantiates itself with ever larger types.")
mc_diagnostic(E0528, overlapping_references, "a `mut &` argument shares memory with another reference argument of the same call.")
mc_diagnostic(E0529, not_a_value, "a type, a module or a variadic function is used as a value.")
mc_diagnostic(E0530, format_string, "a format string must be known at compile time, and its `{}` must match the values; `{{` and `}}` write braces.")
mc_diagnostic(W0501, ambiguous_literal, "a literal fits several operator functions; the one for the literal's default type is used.")
mc_diagnostic(W0502, uninitialized, "a variable may be read before it is assigned; mark it `[uninit]` if that is intended.")
mc_diagnostic(W0503, unused_mut, "a `mut` variable or parameter is never changed.")
mc_diagnostic(W0504, field_not_initialized, "a struct literal leaves a field without a default at zero.")
// command line
mc_diagnostic(E0601, file_not_found, "a file given on the command line cannot be read.")
mc_diagnostic(E0602, usage, "the command line is not valid, or the program cannot be compiled.")
// compile-time evaluation
mc_diagnostic(E0701, not_constant, "a value needed at compile time (constant, array length, default, format) cannot be computed there.")
mc_diagnostic(E0702, constant_cycle, "a constant depends on itself.")
mc_diagnostic(E0703, assertion_failed, "an assertion is false at compile time.")
mc_diagnostic(E0704, division_by_zero, "a division by zero that the compiler can see.")
mc_diagnostic(E0705, evaluation_limit, "compile-time evaluation takes too many steps or recurses too deeply.")
mc_diagnostic(E0706, out_of_bounds, "an index or slice is out of bounds at compile time.")
mc_diagnostic(W0701, overflow, "integer arithmetic on known values wraps around; mark it `[wrap]` if that is intended.")
