
/// the tokens of the language. keywords and punctuators each get their own
/// kind; 'mc_scalar' lists the built-in type names (lexed as type tokens).
/// punctuators are listed longest first: the lexer takes the first match.

mc_keyword(pub)
mc_keyword(let)
mc_keyword(mut)
mc_keyword(if)
mc_keyword(else)
mc_keyword(while)
mc_keyword(for)
mc_keyword(in)
mc_keyword(return)
mc_keyword(break)
mc_keyword(continue)
mc_keyword(import)
mc_keyword(from)
mc_keyword(as)
mc_keyword(true)
mc_keyword(false)
mc_keyword(null)
mc_keyword(sizeof)
mc_keyword(lenof)
mc_keyword(assert)

mc_punctuator(colon_colon, "::")
mc_punctuator(arrow, "->")
mc_punctuator(ellipsis, "...")
mc_punctuator(dot_dot_equal, "..=")
mc_punctuator(shift_left_assign, "<<=")
mc_punctuator(shift_right_assign, ">>=")
mc_punctuator(dot_dot, "..")
mc_punctuator(shift_left, "<<")
mc_punctuator(shift_right, ">>")
mc_punctuator(less_equal, "<=")
mc_punctuator(greater_equal, ">=")
mc_punctuator(equal_equal, "==")
mc_punctuator(not_equal, "!=")
mc_punctuator(and_and, "&&")
mc_punctuator(or_or, "||")
mc_punctuator(plus_assign, "+=")
mc_punctuator(minus_assign, "-=")
mc_punctuator(star_assign, "*=")
mc_punctuator(slash_assign, "/=")
mc_punctuator(percent_assign, "%=")
mc_punctuator(and_assign, "&=")
mc_punctuator(or_assign, "|=")
mc_punctuator(xor_assign, "^=")
mc_punctuator(plus, "+")
mc_punctuator(minus, "-")
mc_punctuator(star, "*")
mc_punctuator(slash, "/")
mc_punctuator(percent, "%")
mc_punctuator(ampersand, "&")
mc_punctuator(pipe, "|")
mc_punctuator(caret, "^")
mc_punctuator(tilde, "~")
mc_punctuator(bang, "!")
mc_punctuator(less, "<")
mc_punctuator(greater, ">")
mc_punctuator(equal, "=")
mc_punctuator(dot, ".")
mc_punctuator(comma, ",")
mc_punctuator(semicolon, ";")
mc_punctuator(colon, ":")
mc_punctuator(left_paren, "(")
mc_punctuator(right_paren, ")")
mc_punctuator(left_bracket, "[")
mc_punctuator(right_bracket, "]")
mc_punctuator(left_brace, "{")
mc_punctuator(right_brace, "}")

// name, kind ('i' integer, 'f' float, 'b' bool), bits (0: a machine word), signed
mc_scalar(s8, 'i', 8, true)
mc_scalar(s16, 'i', 16, true)
mc_scalar(s32, 'i', 32, true)
mc_scalar(s64, 'i', 64, true)
mc_scalar(u8, 'i', 8, false)
mc_scalar(u16, 'i', 16, false)
mc_scalar(u32, 'i', 32, false)
mc_scalar(u64, 'i', 64, false)
mc_scalar(int, 'i', 0, true)
mc_scalar(uint, 'i', 0, false)
mc_scalar(f32, 'f', 32, true)
mc_scalar(f64, 'f', 64, true)
mc_scalar(float, 'f', 0, true)
mc_scalar(bool, 'b', 8, false)
