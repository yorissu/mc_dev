
/// the kinds of syntax tree nodes: the enum name, and the name the tree
/// printer shows (the same names as the python implementation, so that both
/// print identical trees).

// types
mc_node(type_name, "TypeName")
mc_node(type_slice, "TypeSlice")
mc_node(type_array, "TypeArray")
mc_node(type_reference, "TypeReference")
mc_node(type_function, "TypeFunction")
// expressions
mc_node(integer, "IntegerLiteral")
mc_node(float, "FloatLiteral")
mc_node(char, "CharLiteral")
mc_node(string, "StringLiteral")
mc_node(bool, "BoolLiteral")
mc_node(null, "NullLiteral")
mc_node(name, "Name")
mc_node(member, "Member")
mc_node(call, "Call")
mc_node(specialize, "Specialize")
mc_node(index, "Index")
mc_node(slice_of, "SliceOf")
mc_node(unary, "Unary")
mc_node(binary, "Binary")
mc_node(paren, "Paren")
mc_node(cast, "Cast")
mc_node(reference, "Reference")
mc_node(entry, "Entry")
mc_node(composite, "Composite")
mc_node(lambda, "Lambda")
mc_node(sizeof, "SizeOf")
mc_node(lenof, "LenOf")
mc_node(assert, "Assert")
// statements
mc_node(attribute, "Attribute")
mc_node(let, "Let")
mc_node(declaration_statement, "DeclarationStatement")
mc_node(if, "If")
mc_node(while, "While")
mc_node(for, "For")
mc_node(return, "Return")
mc_node(break, "Break")
mc_node(continue, "Continue")
mc_node(block, "Block")
mc_node(expression_statement, "ExpressionStatement")
mc_node(assign, "Assign")
// declarations
mc_node(generic, "Generic")
mc_node(param, "Param")
mc_node(field, "Field")
mc_node(function, "Function")
mc_node(struct, "Struct")
mc_node(constant, "Constant")
mc_node(import_name, "ImportName")
mc_node(import, "Import")
mc_node(from_import, "FromImport")
mc_node(module, "Module")
