
# format specifiers: {:[[fill]align][sign][#][0][width][.precision][type]}

from io import print, println

Pair :: {
	let a: int;
	let b: [2]u8;
}

pub main :: () {
	println("[{:>8}] [{:<6}] [{:^9}] [{:*^9}] [{:+}] [{:05}] [{:+06}]", 42, -7, "mid", true, 3, -42, 7);
	println("[{:x}] [{:X}] [{:#x}] [{:#X}] [{:o}] [{:#o}] [{:b}] [{:#b}] [{:#010x}]", 255, 255, 255, 255, 8, 8, 5u8, 5u8, 255);
	println("[{:x}] [{:d}] [{:x}] [{:b}] [{}]", -255, (s8)-128, (u64)18446744073709551615, (s16)-2, (u32)4000000000);
	println("[{:.3f}] [{:08.3f}] [{:e}] [{:.2e}] [{:E}] [{:.3g}] [{:g}] [{:.1}] [{:10.4}]", 3.14159, -3.14159, 1234.5, 0.000123, 1e20, 1234.5, 0.1, 2.25, 1.0 / 3.0);
	println("[{:>8}] [{:<8}] [{:+.1f}] [{:08}] [{:^7.2f}]", 0.1f32, 1.5f32, 2.5f32, 1.0 / 0.0, -0.0);
	println("[{:>20}] [{:<12}|] [{:^5}]", (Pair){ a: 1, b: "ok", }, "{}", 'x');
	println("[{:3}] [{:<4}] [{:>4}] [{:_>6}]", "héllo", "é", "日本", false);
	print("{{}} {{{}}} {:}", 1, 2);
	println("");
}
