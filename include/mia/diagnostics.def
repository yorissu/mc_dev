
/// every diagnostic: its code, a short name and an explanation (shown by
/// 'mia explain <code>'). 'E' codes are errors, 'W' warnings. the two digits
/// after the letter are the area: 01 lexing, 02 syntax, 03 modules,
/// 04 declarations and attributes, 05 types, 06 command line,
/// 07 compile-time evaluation.
///
/// to add a diagnostic, add a line here and report it with mia_diag_error/mia_diag_warning.

// lexing
mia_diag_code(E0101, unknown_character, "a character that is not part of the language (outside strings and comments).")
mia_diag_code(E0102, unterminated_string, "a string literal is not closed before the end of its line.")
mia_diag_code(E0103, unterminated_comment, "a block comment is not closed; block comments nest, so every `/*` needs its own `*/`.")
mia_diag_code(E0104, invalid_escape, "an unknown escape in a string or character literal. valid: \\n \\t \\r \\0 \\\\ \\\" \\' \\xHH.")
mia_diag_code(E0105, invalid_number, "a malformed number: misplaced `_`, an unknown suffix, or a float suffix on a hexadecimal number.")
mia_diag_code(E0106, invalid_character_literal, "a character literal must hold exactly one byte, like 'a' or '\\n'.")
mia_diag_code(E0107, invalid_string_suffix, "the only string suffix is `c`, which adds a terminating NUL: \"text\"c.")
mia_diag_code(E0108, nul_in_c_string, "a C string (\"...\"c) contains a NUL byte; C would stop reading there.")
mia_diag_code(E0109, multiline_string_layout, "a multiline string starts on the line after its opening `\"\"\"`, ends with `\"\"\"` on a line of its own, and no line is indented less than that closing `\"\"\"`.")
// syntax
mia_diag_code(E0201, unexpected_token, "the parser expected something else here.")
mia_diag_code(E0202, ambiguous_precedence, "operators are strict: bit operators, shifts, mixing `&&` with `||`, and chained comparisons need parentheses.")
mia_diag_code(E0203, empty_struct, "a struct needs at least one `let` field.")
mia_diag_code(E0204, invalid_attribute, "a malformed attribute list `[name, name = value]`, or attributes where none are allowed.")
mia_diag_code(E0205, misplaced_declaration, "structs and generic declarations are only allowed at module level; local declarations cannot be `pub`.")
mia_diag_code(E0206, invalid_braceless_body, "a body without braces (after `then` or `else`, of an `if`, a loop or a function) is one statement: not a declaration, and not a block after `then`.")
mia_diag_code(E0207, nesting_too_deep, "expressions, statements and types nest at most 1000 deep (a long chain of operators counts each one), and structs inside structs too.")
// modules
mia_diag_code(E0301, module_not_found, "an imported module was not found in any search directory.")
mia_diag_code(E0302, import_cycle, "modules import each other in a cycle; move shared declarations into their own module.")
mia_diag_code(E0303, not_public, "a declaration of another module is used, but it is not `pub`.")
mia_diag_code(E0304, ambiguous_import, "a name is provided by several `*` imports; import it explicitly or declare it.")
mia_diag_code(E0305, unknown_module_member, "a module does not declare the requested name.")
mia_diag_code(E0306, duplicate_import, "the same name is imported twice.")
mia_diag_code(E0307, import_depth, "modules import each other in a chain more than 1000 long.")
// declarations and attributes
mia_diag_code(E0401, duplicate_declaration, "a name is declared twice in the same scope.")
mia_diag_code(E0402, unknown_attribute, "an attribute that does not exist.")
mia_diag_code(E0403, attribute_not_applicable, "an attribute that does not apply here, is repeated, or has a wrong value.")
mia_diag_code(E0404, missing_body, "a function has no body; only `[plugin = \"name\"]` functions are declared without one.")
mia_diag_code(E0405, unexpected_body, "`[plugin = \"name\"]` functions are provided by a plugin and cannot have a body.")
mia_diag_code(E0411, invalid_main, "the entry module needs `pub main :: ()` or `pub main :: () -> int`; `main` may take the command line: `pub main :: (arguments: [][]u8) -> int`.")
mia_diag_code(E0412, default_parameter_order, "parameters with defaults must come last; lambdas cannot have defaults.")
mia_diag_code(E0413, reference_not_allowed, "references (`&T`) exist only as parameter types; use a slice to keep a view of an array.")
mia_diag_code(E0414, recursive_struct, "a struct contains itself by value; store it through a slice instead.")
mia_diag_code(E0415, variadic_parameter, "only plugin functions take `...`, and only as their last parameter.")
mia_diag_code(E0416, missing_plugin, "a plugin function is used, but the plugin its declaration names does not provide it, or is in no plugin directory (the program's, the stdlib's, `-P`).")
// types
mia_diag_code(E0501, undefined_name, "a name that is not declared (or not imported).")
mia_diag_code(E0502, type_mismatch, "a value of one type is used where another type is expected; mia never converts implicitly.")
mia_diag_code(E0503, not_a_type, "a name used as a type does not name a type.")
mia_diag_code(E0504, not_callable, "a call of something that is not a function.")
mia_diag_code(E0505, argument_count, "a call with the wrong number of arguments.")
mia_diag_code(E0506, cannot_infer, "the compiler cannot work out a type; write it explicitly.")
mia_diag_code(E0507, invalid_operands, "an operator does not apply to these operand types (never to structs); mixed number types need a cast.")
mia_diag_code(E0508, not_assignable, "an assignment to something that is not a variable, a field or an element: a constant, a function or a temporary.")
mia_diag_code(E0509, discarded_result, "the result of an expression is not used; write `_ = expression;` to discard it on purpose.")
mia_diag_code(E0510, invalid_cast, "casts convert between number types only.")
mia_diag_code(E0511, literal_out_of_range, "a literal does not fit in its type.")
mia_diag_code(E0512, no_such_field, "a struct has no field of this name.")
mia_diag_code(E0513, not_indexable, "only arrays and slices can be indexed.")
mia_diag_code(E0514, missing_return, "a function with a result can reach its end without returning.")
mia_diag_code(E0515, outside_loop, "`break` or `continue` outside of a loop.")
mia_diag_code(E0516, capture, "lambdas and local functions cannot use variables of the enclosing function; pass them as arguments.")
mia_diag_code(E0517, reference_argument, "a reference parameter needs `&value` at the call, unless the value is a reference parameter of the caller.")
mia_diag_code(E0519, misplaced_reference, "`&` is only allowed on arguments of reference parameters, and not on a reference parameter passed on: it already is one.")
mia_diag_code(E0520, generic_argument_count, "a generic needs exactly as many type arguments as it has type parameters.")
mia_diag_code(E0521, not_generic, "type arguments given to something that is not generic.")
mia_diag_code(E0522, private_field, "the fields of a struct that is not `pub` are private to its module.")
mia_diag_code(E0523, no_value, "a function without a result is used as a value.")
mia_diag_code(E0524, invalid_return, "`return` with a value in a function without a result, or without one in a function with a result.")
mia_diag_code(E0525, invalid_literal, "a `{ ... }` literal does not fit its type: names for structs, the right number of elements for arrays.")
mia_diag_code(E0526, no_zero_value, "function types have no zero value, so `{}` and omitted fields of that type are not allowed.")
mia_diag_code(E0527, instantiation_depth, "a generic function instantiates itself with ever larger types.")
mia_diag_code(E0529, not_a_value, "a type, a module or a variadic function is used as a value.")
mia_diag_code(E0530, format_string, "a format string must be known at compile time, and its `{}` must match the values; `{{` and `}}` write braces.")
mia_diag_code(E0531, plugin_check, "the check of a plugin function rejected a call; the message says why.")
mia_diag_code(E0532, type_too_large, "a type takes more than 4294967296 bytes (4 GiB), the most the machine allows.")
mia_diag_code(W0502, uninitialized, "a variable may be read before it is assigned; mark it `[uninit]` if that is intended.")
mia_diag_code(W0504, field_not_initialized, "a struct literal leaves a field without a default at zero.")
mia_diag_code(W0531, plugin_warning, "the check of a plugin function warns about a call; the message says why.")
// command line
mia_diag_code(E0601, file_not_found, "a file given on the command line cannot be read.")
mia_diag_code(E0602, usage, "the command line is not valid, or the program cannot be compiled.")
mia_diag_code(E0603, plugin_load, "a plugin cannot be loaded: the file is missing or is not a mia plugin, it needs a newer mia, or it provides a function another plugin provides.")
// compile-time evaluation
mia_diag_code(E0701, not_constant, "a value needed at compile time (constant, array length, default, format) cannot be computed there.")
mia_diag_code(E0702, constant_cycle, "a constant depends on itself.")
mia_diag_code(E0703, assertion_failed, "an assertion is false at compile time.")
mia_diag_code(E0704, division_by_zero, "a division by zero that the compiler can see.")
mia_diag_code(E0705, evaluation_limit, "compile-time evaluation takes too many steps or recurses too deeply.")
mia_diag_code(E0706, out_of_bounds, "an index or slice is out of bounds at compile time.")
mia_diag_code(W0701, overflow, "integer arithmetic on known values wraps around; mark it `[wrap]` if that is intended.")
