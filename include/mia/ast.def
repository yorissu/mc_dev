
/// the kinds of syntax tree nodes: the enum name, and the name the tree
/// printer shows ('mia ast', and the expectations of the tests).

// types
mia_ast_node(type_name, "TypeName")
mia_ast_node(type_slice, "TypeSlice")
mia_ast_node(type_array, "TypeArray")
mia_ast_node(type_reference, "TypeReference")
mia_ast_node(type_function, "TypeFunction")
// expressions
mia_ast_node(integer, "IntegerLiteral")
mia_ast_node(float, "FloatLiteral")
mia_ast_node(char, "CharLiteral")
mia_ast_node(string, "StringLiteral")
mia_ast_node(bool, "BoolLiteral")
mia_ast_node(name, "Name")
mia_ast_node(member, "Member")
mia_ast_node(call, "Call")
mia_ast_node(specialize, "Specialize")
mia_ast_node(index, "Index")
mia_ast_node(slice_of, "SliceOf")
mia_ast_node(unary, "Unary")
mia_ast_node(binary, "Binary")
mia_ast_node(paren, "Paren")
mia_ast_node(cast, "Cast")
mia_ast_node(reference, "Reference")
mia_ast_node(entry, "Entry")
mia_ast_node(composite, "Composite")
mia_ast_node(lambda, "Lambda")
mia_ast_node(sizeof, "SizeOf")
mia_ast_node(lenof, "LenOf")
mia_ast_node(assert, "Assert")
// statements
mia_ast_node(attribute, "Attribute")
mia_ast_node(let, "Let")
mia_ast_node(declaration_statement, "DeclarationStatement")
mia_ast_node(if, "If")
mia_ast_node(while, "While")
mia_ast_node(for, "For")
mia_ast_node(return, "Return")
mia_ast_node(break, "Break")
mia_ast_node(continue, "Continue")
mia_ast_node(block, "Block")
mia_ast_node(expression_statement, "ExpressionStatement")
mia_ast_node(assign, "Assign")
// declarations
mia_ast_node(generic, "Generic")
mia_ast_node(param, "Param")
mia_ast_node(field, "Field")
mia_ast_node(function, "Function")
mia_ast_node(struct, "Struct")
mia_ast_node(constant, "Constant")
mia_ast_node(import_name, "ImportName")
mia_ast_node(import, "Import")
mia_ast_node(from_import, "FromImport")
mia_ast_node(module, "Module")
