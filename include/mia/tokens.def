
/// the tokens of the language. keywords and punctuators each get their own
/// kind; 'mia_token_scalar' lists the built-in type names (lexed as type tokens).
/// punctuators are listed longest first: the lexer takes the first match.

mia_token_keyword(pub)
mia_token_keyword(let)
mia_token_keyword(if)
mia_token_keyword(else)
mia_token_keyword(then)
mia_token_keyword(while)
mia_token_keyword(for)
mia_token_keyword(in)
mia_token_keyword(return)
mia_token_keyword(break)
mia_token_keyword(continue)
mia_token_keyword(import)
mia_token_keyword(from)
mia_token_keyword(as)
mia_token_keyword(true)
mia_token_keyword(false)
mia_token_keyword(sizeof)
mia_token_keyword(lenof)
mia_token_keyword(assert)

mia_token_punctuator(colon_colon, "::")
mia_token_punctuator(arrow, "->")
mia_token_punctuator(ellipsis, "...")
mia_token_punctuator(dot_dot_equal, "..=")
mia_token_punctuator(shift_left_assign, "<<=")
mia_token_punctuator(shift_right_assign, ">>=")
mia_token_punctuator(dot_dot, "..")
mia_token_punctuator(shift_left, "<<")
mia_token_punctuator(shift_right, ">>")
mia_token_punctuator(less_equal, "<=")
mia_token_punctuator(greater_equal, ">=")
mia_token_punctuator(equal_equal, "==")
mia_token_punctuator(not_equal, "!=")
mia_token_punctuator(and_and, "&&")
mia_token_punctuator(or_or, "||")
mia_token_punctuator(plus_assign, "+=")
mia_token_punctuator(minus_assign, "-=")
mia_token_punctuator(star_assign, "*=")
mia_token_punctuator(slash_assign, "/=")
mia_token_punctuator(percent_assign, "%=")
mia_token_punctuator(and_assign, "&=")
mia_token_punctuator(or_assign, "|=")
mia_token_punctuator(xor_assign, "^=")
mia_token_punctuator(plus, "+")
mia_token_punctuator(minus, "-")
mia_token_punctuator(star, "*")
mia_token_punctuator(slash, "/")
mia_token_punctuator(percent, "%")
mia_token_punctuator(ampersand, "&")
mia_token_punctuator(pipe, "|")
mia_token_punctuator(caret, "^")
mia_token_punctuator(tilde, "~")
mia_token_punctuator(bang, "!")
mia_token_punctuator(less, "<")
mia_token_punctuator(greater, ">")
mia_token_punctuator(equal, "=")
mia_token_punctuator(dot, ".")
mia_token_punctuator(comma, ",")
mia_token_punctuator(semicolon, ";")
mia_token_punctuator(colon, ":")
mia_token_punctuator(left_paren, "(")
mia_token_punctuator(right_paren, ")")
mia_token_punctuator(left_bracket, "[")
mia_token_punctuator(right_bracket, "]")
mia_token_punctuator(left_brace, "{")
mia_token_punctuator(right_brace, "}")

// name, kind ('i' integer, 'f' float, 'b' bool), bits (0: a machine word), signed
mia_token_scalar(s8, 'i', 8, true)
mia_token_scalar(s16, 'i', 16, true)
mia_token_scalar(s32, 'i', 32, true)
mia_token_scalar(s64, 'i', 64, true)
mia_token_scalar(u8, 'i', 8, false)
mia_token_scalar(u16, 'i', 16, false)
mia_token_scalar(u32, 'i', 32, false)
mia_token_scalar(u64, 'i', 64, false)
mia_token_scalar(int, 'i', 0, true)
mia_token_scalar(uint, 'i', 0, false)
mia_token_scalar(f32, 'f', 32, true)
mia_token_scalar(f64, 'f', 64, true)
mia_token_scalar(float, 'f', 0, true)
mia_token_scalar(bool, 'b', 8, false)
